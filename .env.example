# Copia este archivo a `.env` (NO se sube al repo) y reinicia `npm run dev`.

# Leaflet: clave gratuita de tiles CARTO (https://carto.com/basemaps/apikey/).
# Si la dejas vacía, Leaflet usa los tiles públicos de OpenStreetMap como respaldo.
VITE_CARTO_KEY=

# Google Maps: clave de "Maps JavaScript API".
# IMPORTANTE: restríngela por HTTP referrer (localhost:5173 y tu dominio) en Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: ID de mapa propio (Google Cloud > Map Management). Si no, usa DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=

# Backend: nunca uses prefijo VITE_ para secretos.
PORT=3001
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ADMIN_EMAILS=
DATABASE_PATH=server/data/access.sqlite
DRIVE_CONFIG_PATH=server/config.local.json

# Cliente OAuth web para Google Identity Services. El ID es público; el secreto no.
GOOGLE_CLIENT_ID=

# Opción A: cuenta de servicio + unidad compartida Workspace.
# Ruta absoluta a un JSON privado fuera de public/ y dist/.
GOOGLE_APPLICATION_CREDENTIALS=

# Opción B: OAuth de una cuenta dedicada al proyecto (Mi unidad).
# No completar si usas la opción A.
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
